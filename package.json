{
  "name": "churchvault",
  "version": "0.1.0",
  "description": "Encrypted shared vault for church secrets, synced through Git",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
